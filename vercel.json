{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/(.*)", "dest": "/api/index?__ms_route=/$1" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{morning_signal.sqlite3*,**/*.sqlite3,**/*.sqlite,**/*.db,**/*.dump,**/*.backup,**/*.bak,test_*.py,offline_evaluation.py,import_sqlite_to_mysql.py}"
    }
  }
}
